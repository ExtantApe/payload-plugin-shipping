{
  "name": "@extantape/payload-plugin-shipping",
  "version": "0.1.0",
  "description": "Shipping for Payload: addresses, carrier rates, labels, refunds of unused labels and tracking webhooks, with EasyPost as the first carrier provider.",
  "homepage": "https://github.com/ExtantApe/payload-plugin-shipping#readme",
  "bugs": {
    "url": "https://github.com/ExtantApe/payload-plugin-shipping/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "ecommerce",
    "integrations",
    "shipping",
    "easypost",
    "usps",
    "postage",
    "shipping-labels",
    "tracking",
    "webhooks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtantApe/payload-plugin-shipping.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "leak-check": "bash scripts/leak-check.sh",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "payload": "^3.80.0"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@types/node": "^24.0.0",
    "graphql": "^16.14.2",
    "mongodb-memory-server": "^11.3.0",
    "payload": "3.92.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
